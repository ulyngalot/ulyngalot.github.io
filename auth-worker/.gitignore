# Local secrets for `wrangler dev`. Never commit this: in production the same
# values are set with `wrangler secret put` or in a KV namespace.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler also reads .env here; a CLOUDFLARE_API_TOKEN placed in one must
# never be committed.
.env
.env.*

node_modules/
.wrangler/
